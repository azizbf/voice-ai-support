# Backend — copy to backend/.env and fill in real values (never commit backend/.env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VOICE_MODEL=claude-haiku-4-5

# PostgreSQL (optional — dashboard / SaaS metadata)
# CREATE DATABASE vantage_ai;
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/vantage_ai
DASHBOARD_API_KEY=dev-dashboard-key

# Optional: Voyage embeddings (falls back to local sentence-transformers)
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=voyage

# Optional STT (fallback: faster-whisper / browser speech)
# DEEPGRAM_API_KEY=
# Local Whisper size on CPU: tiny (fastest) | base (default) | small (slower, more accurate)
# WHISPER_MODEL=base
# WHISPER_CPU_THREADS=4

# Vectors: auto (pgvector when DATABASE_URL is set, else FAISS) | pgvector | faiss
# VECTOR_STORE=auto

# TTS: Microsoft edge-tts Denise by default (no key required)
EDGE_TTS_VOICE=fr-FR-DeniseNeural
# Optional ElevenLabs bidirectional streaming (requires key and voice ID)
TTS_PROVIDER=edge
ELEVENLABS_MODEL=eleven_flash_v2_5
# Set TTS_PROVIDER=elevenlabs to activate
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

APP_ENV=development
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
MAX_UPLOAD_BYTES=10485760
TENANT_TTL_HOURS=24
PERSIST_DOCUMENTS=false
DEMO_SIGNING_SECRET=change-me-in-production

# Frontend — copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_DASHBOARD_KEY=dev-dashboard-key
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_VOICE_SILENCE_MS=800
WHISPER_DEVICE=cpu

# Experimental local Silero VAD + Smart Turn (server). Off until verified.
# When true, the browser streams 16 kHz PCM during speech instead of WebM-after-silence.
VOICE_SMART_TURN=false
